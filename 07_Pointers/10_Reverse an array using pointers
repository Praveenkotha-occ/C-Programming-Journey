#include<stdio.h>
void swap ( int *a , int *b){
    int temp = *a;
    *a = *b;
    *b = temp;
}

int main(){
    int size ; scanf("%d", &size);
    int arr[size];
    
    for ( int i = 0 ; i < size ; i++){
        scanf("%d", &arr[i]);
    }
    int *left = arr;
    int *right = arr+size-1;
    
    while (left < right){
        swap(left, right);
        left++;
        right--;
    }
    
    for ( int i = 0  ; i < size ; i++){
        printf("%d", arr[i]);
    }
    
}
